# =============================================================
# kios-xm — mẫu biến môi trường
# Sao chép thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local
#   cp env.example .env.local
# =============================================================

# --- Ứng dụng ---
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Cơ sở dữ liệu (Supabase) ---
# Supabase Dashboard → Project Settings → Database → Connection string
# DATABASE_URL  : pooler, cổng 6543 — dùng lúc chạy
# DIRECT_URL    : kết nối trực tiếp, cổng 5432 — dùng cho prisma migrate
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Xác thực (Auth.js) ---
# Sinh bằng: openssl rand -base64 32
AUTH_SECRET=""

# --- Google Drive (lưu trữ tệp) ---
# Lấy từ file client_secret_*.json tải về từ Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Phải TRÙNG KHỚP TUYỆT ĐỐI với "Authorized redirect URI" khai trong Google Cloud Console
GOOGLE_REDIRECT_URI="http://localhost:3000/api/drive/callback"
# Có được sau lần kết nối đầu (Thiết lập → Kết nối Google Drive). Lưu mã hoá trong DB.
GOOGLE_REFRESH_TOKEN=""
# ID thư mục gốc DO CHÍNH ỨNG DỤNG TẠO ở lần kết nối đầu.
# Để trống lần đầu — hệ thống tự tạo rồi ghi lại. Lý do không dùng thư mục có sẵn: ADR-002 §2.2
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# --- Mã hoá dữ liệu nhạy cảm (refresh token…) ---
# Sinh bằng: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Sao lưu ---
BACKUP_RETENTION_DAYS="30"
