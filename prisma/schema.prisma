// kios-xm — schema M0 (nền móng)
// Quy ước: model PascalCase, bảng/cột snake_case qua @map/@@map.
// Bám 7 quy tắc bắt buộc trong AGENTS.md §3b và ADR-001.

generator client {
  // Generator mới của Prisma 7: sinh mã theo runtime đích.
  // "workerd" chọn loader nạp WASM bằng import tĩnh — Cloudflare cấm biên dịch
  // WASM lúc chạy, nên loader mặc định sẽ hỏng trên production.
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // Chuỗi kết nối khai trong prisma.config.ts (Prisma 7 không còn nhận url ở đây)
}

// ───────────────────────── Nền tảng ─────────────────────────

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  plan      String   @default("free")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches     Branch[]
  users        User[]
  roles        Role[]
  employees    Employee[]
  departments  Department[]
  positions    Position[]
  features     TenantFeature[]
  settings     TenantSettings?
  files        StoredFile[]
  outboxEvents OutboxEvent[]
  auditLogs    AuditLog[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  address   String?
  phone     String?
  timezone  String   @default("Asia/Ho_Chi_Minh")
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userBranchRoles  UserBranchRole[]
  employeesWorking Employee[]      @relation("EmployeeWorkBranch")
  employeesPaid    Employee[]      @relation("EmployeePayBranch")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

/// Tài khoản ĐĂNG NHẬP phần mềm. Khác với Employee (người được ghi nhận nghiệp vụ).
/// Xem AGENTS.md §3b quy tắc 1.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String?
  phone        String?
  passwordHash String?   @map("password_hash")
  fullName     String    @map("full_name")
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchRoles UserBranchRole[]
  employee    Employee?
  auditLogs   AuditLog[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String
  /// Danh sách quyền dạng "module.action", xem lib/auth/permissions.ts
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchRoles UserBranchRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model UserBranchRole {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, branchId, roleId])
  @@index([branchId])
  @@map("user_branch_roles")
}

// ───────────────────────── Nhân sự ─────────────────────────

/// Người được GHI NHẬN NGHIỆP VỤ (làm dịch vụ, tư vấn, thu ngân).
/// Có thể KHÔNG có tài khoản đăng nhập -> userId nullable. AGENTS.md §3b quy tắc 1.
model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid
  code           String
  clockCode      String?   @map("clock_code")
  fullName       String    @map("full_name")
  phone          String?
  email          String?
  gender         Gender?
  birthday       DateTime? @db.Date
  idNumber       String?   @map("id_number")
  address        String?
  bankAccount    String?   @map("bank_account")
  bankName       String?
  note           String?
  hiredAt        DateTime? @map("hired_at") @db.Date
  leftAt         DateTime? @map("left_at") @db.Date
  status         EmployeeStatus @default(working)
  departmentId   String?   @map("department_id") @db.Uuid
  positionId     String?   @map("position_id") @db.Uuid
  workBranchId   String?   @map("work_branch_id") @db.Uuid
  payBranchId    String?   @map("pay_branch_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position    Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  workBranch  Branch?     @relation("EmployeeWorkBranch", fields: [workBranchId], references: [id], onDelete: SetNull)
  payBranch   Branch?     @relation("EmployeePayBranch", fields: [payBranchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("employees")
}

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  name      String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, name])
  @@map("departments")
}

model Position {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  name      String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, name])
  @@map("positions")
}

// ───────────────────── Cấu hình theo tenant ─────────────────────

model TenantFeature {
  tenantId   String  @map("tenant_id") @db.Uuid
  featureKey String  @map("feature_key")
  enabled    Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, featureKey])
  @@map("tenant_features")
}

model TenantSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  /// Bước chia lưới lịch hẹn: 15 | 30 | 60. ADR-001 §3.7 — KHÔNG hard-code.
  bookingSlotMinutes   Int     @default(30) @map("booking_slot_minutes")
  /// Khoảng nghỉ giữa 2 dịch vụ trong cùng lịch hẹn (phút).
  bookingBufferMinutes Int     @default(5) @map("booking_buffer_minutes")
  /// Chỉ cho đặt lịch KTV trong ca làm việc của họ.
  limitBookingToShift  Boolean @default(false) @map("limit_booking_to_shift")

  /// Cách phân bổ giá trị gói cho từng buổi. ADR-001 §1.3.
  packageRevenueAllocationMode PackageAllocationMode @default(proportional_retail) @map("package_revenue_allocation_mode")

  /// Phương pháp tính giá vốn.
  costingMethod CostingMethod @default(average) @map("costing_method")

  /// Khoá sổ: cấm mọi thay đổi có ngày <= mốc này (G12).
  bookClosedUntil DateTime? @map("book_closed_until") @db.Date

  /// Thư mục gốc trên Google Drive do CHÍNH ỨNG DỤNG tạo (ADR-002 §2.2).
  driveRootFolderId String? @map("drive_root_folder_id")
  /// Refresh token Google đã mã hoá bằng ENCRYPTION_KEY.
  driveRefreshToken String? @map("drive_refresh_token")
  driveConnectedAt  DateTime? @map("drive_connected_at") @db.Timestamptz(6)
  driveConnectedEmail String? @map("drive_connected_email")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// ───────────────────── Hạ tầng dùng chung ─────────────────────

/// Mọi tệp đều đi qua StorageAdapter; bảng này giữ dấu vết để đổi nhà cung cấp
/// mà không mất dữ liệu. ADR-002 §2.5.
model StoredFile {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  provider   String   @default("google_drive")
  externalId String   @map("external_id")
  path       String
  mime       String
  size       Int
  checksum   String?
  /// Tệp thumbnail tương ứng (nếu có) — bù cho việc Drive không phải CDN.
  thumbExternalId String? @map("thumb_external_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, path])
  @@map("files")
}

/// Side-effect ra ngoài DB (Zalo/SMS/email) — ghi trong transaction, gửi sau commit.
/// ADR-001 §2.4.
model OutboxEvent {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  kind      String
  payload   Json
  status    OutboxStatus @default(pending)
  attempts  Int         @default(0)
  lastError String?     @map("last_error")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt    DateTime?   @map("sent_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("outbox_events")
}

/// Nhật ký thao tác. Bắt buộc ghi với: tiền, lịch hẹn, hồ sơ y tế, đổi attribution hoá đơn.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entity     String
  entityId   String   @map("entity_id")
  action     String
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_log")
}

// ───────────────────────── Enum ─────────────────────────

enum Gender {
  male
  female
  other
}

enum EmployeeStatus {
  working
  left
}

enum PackageAllocationMode {
  proportional_retail
  equal_per_session
  custom
}

enum CostingMethod {
  average
  fixed
}

enum OutboxStatus {
  pending
  sent
  failed
}
